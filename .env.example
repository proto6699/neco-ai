# Local-only by default. Set 0.0.0.0 deliberately for LAN access.
OPENWEBUI_BIND=127.0.0.1
OPENWEBUI_PORT=3000
WEBUI_SECRET_KEY=

# Must exactly match a name in ollama list (and be visible in Open WebUI).
# Default: Llama 3.1 8B (~4.9 GB, Q4). Fits most 8 GB+ GPUs (RTX 3060/3070 class).
# Weaker hardware: llama3.2:3b or llama3.2:1b with NECO_PERSONA=lite.
NECO_MODEL=llama3.1:8b
# lite: compact prompt for tiny models. full: identity + orientation + voice, recommended for stronger models such as Llama 3.1 8B.
NECO_PERSONA=full
# Which cat lives here: a folder name under characters/ (neco, coneco, sakamoto).
# Easiest way to change: ./scripts/change-cat.sh
NECO_CHARACTER=neco
NECO_MIN_INTERVAL=1200
NECO_MAX_INTERVAL=2700
# Idle reply budget. Reasoning models (qwen3, deepseek) spend part of it thinking.
NECO_MAX_TOKENS=1500
# Seconds to wait for one idle generation, including a cold model load.
NECO_GEN_TIMEOUT=600
# Left blank: the installer asks (defaults to your login name).
OWNER_NAME=
NECO_MACHINE="this machine"

# Persistent continuity. The worker scans completed Neco exchanges, ignores trivial chatter,
# consolidates meaningful events into .runtime/neco-memory.sqlite3, and the Open WebUI
# memory filter retrieves only a few relevant memories per turn.
NECO_MEMORY_ENABLED=1
NECO_MEMORY_INTERVAL=30
# 0 means existing chats are marked as history and memory starts from new exchanges.
NECO_MEMORY_BACKFILL=0
# Optional Open WebUI model ID for consolidation. Blank = use NECO_MODEL.
NECO_REFLECTION_MODEL=
